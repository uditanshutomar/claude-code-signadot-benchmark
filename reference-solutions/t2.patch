diff --git a/services/location/ride_history.go b/services/location/ride_history.go
new file mode 100644
index 0000000..c2db98a
--- /dev/null
+++ b/services/location/ride_history.go
@@ -0,0 +1,98 @@
+package location
+
+import (
+	"database/sql"
+	"encoding/json"
+	"net/http"
+	"time"
+)
+
+type RideHistory struct {
+	ID          int64     `json:"id"`
+	Pickup      string    `json:"pickup"`
+	Dropoff     string    `json:"dropoff"`
+	RequestTime time.Time `json:"requestTime"`
+	DriverPlate string    `json:"driverPlate"`
+	Fare        float64   `json:"fare"`
+}
+
+func (s *Server) rideHistory(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	_, err := s.database.db.ExecContext(ctx, `CREATE TABLE IF NOT EXISTS ride_history (
+ id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
+ pickup VARCHAR(255) NOT NULL, dropoff VARCHAR(255) NOT NULL,
+ request_time DATETIME(6) NOT NULL, driver_plate VARCHAR(255) NOT NULL DEFAULT '',
+ fare DECIMAL(12,2) NOT NULL DEFAULT 0)`)
+	if err != nil {
+		http.Error(w, "could not prepare ride history", 500)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	switch r.Method {
+	case http.MethodGet:
+		rows, err := s.database.db.QueryContext(ctx, "SELECT id,pickup,dropoff,request_time,driver_plate,fare FROM ride_history ORDER BY id DESC")
+		if err != nil {
+			http.Error(w, "could not list history", 500)
+			return
+		}
+		defer rows.Close()
+		rides := []RideHistory{}
+		for rows.Next() {
+			var ride RideHistory
+			if err = rows.Scan(&ride.ID, &ride.Pickup, &ride.Dropoff, &ride.RequestTime, &ride.DriverPlate, &ride.Fare); err != nil {
+				http.Error(w, "could not read history", 500)
+				return
+			}
+			rides = append(rides, ride)
+		}
+		if rows.Err() != nil {
+			http.Error(w, "could not read history", 500)
+			return
+		}
+		json.NewEncoder(w).Encode(map[string]any{"rides": rides, "total": len(rides)})
+	case http.MethodPost:
+		var ride RideHistory
+		if json.NewDecoder(http.MaxBytesReader(w, r.Body, 8192)).Decode(&ride) != nil || ride.Pickup == "" || ride.Dropoff == "" {
+			http.Error(w, "pickup and dropoff are required", 400)
+			return
+		}
+		ride.RequestTime = time.Now().UTC()
+		result, err := s.database.db.ExecContext(ctx, "INSERT INTO ride_history(pickup,dropoff,request_time) VALUES(?,?,?)", ride.Pickup, ride.Dropoff, ride.RequestTime)
+		if err != nil {
+			http.Error(w, "could not create history", 500)
+			return
+		}
+		ride.ID, err = result.LastInsertId()
+		if err != nil {
+			http.Error(w, "could not read history id", 500)
+			return
+		}
+		w.WriteHeader(http.StatusCreated)
+		json.NewEncoder(w).Encode(ride)
+	case http.MethodPatch:
+		var ride RideHistory
+		if json.NewDecoder(http.MaxBytesReader(w, r.Body, 8192)).Decode(&ride) != nil || ride.ID <= 0 || ride.DriverPlate == "" || ride.Fare < 0 {
+			http.Error(w, "id, plate and nonnegative fare required", 400)
+			return
+		}
+		var exists int
+		err = s.database.db.QueryRowContext(ctx, "SELECT 1 FROM ride_history WHERE id=?", ride.ID).Scan(&exists)
+		if err == sql.ErrNoRows {
+			http.Error(w, "ride not found", 404)
+			return
+		}
+		if err != nil {
+			http.Error(w, "could not read history", 500)
+			return
+		}
+		_, err = s.database.db.ExecContext(ctx, "UPDATE ride_history SET driver_plate=?,fare=? WHERE id=?", ride.DriverPlate, ride.Fare, ride.ID)
+		if err != nil {
+			http.Error(w, "could not update history", 500)
+			return
+		}
+		json.NewEncoder(w).Encode(map[string]bool{"updated": true})
+	default:
+		w.Header().Set("Allow", "GET, POST, PATCH")
+		http.Error(w, "method not allowed", 405)
+	}
+}
