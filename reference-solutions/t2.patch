new file mode 100644
index 0000000..53377d6
--- /dev/null
+++ b/services/frontend/ride_history.go
@@ -0,0 +1,28 @@
+package frontend
+
+import (
+	"github.com/signadot/hotrod/pkg/config"
+	"github.com/signadot/hotrod/pkg/tracing"
+	"io"
+	"net/http"
+)
+
+func (s *Server) rideHistory(w http.ResponseWriter, r *http.Request) {
+	req, err := http.NewRequestWithContext(r.Context(), r.Method, "http://"+config.GetLocationAddr()+"/ride-history"+"?"+r.URL.RawQuery, r.Body)
+	if err != nil {
+		http.Error(w, "invalid history request", 400)
+		return
+	}
+	req.Header.Set("Content-Type", r.Header.Get("Content-Type"))
+	req.Header.Set("Accept", "application/json")
+	client := tracing.NewHTTPClient(s.tracer)
+	resp, err := client.Client.Do(req)
+	if err != nil {
+		http.Error(w, "history service unavailable", 502)
+		return
+	}
+	defer resp.Body.Close()
+	w.Header().Set("Content-Type", resp.Header.Get("Content-Type"))
+	w.WriteHeader(resp.StatusCode)
+	io.Copy(w, resp.Body)
+}
