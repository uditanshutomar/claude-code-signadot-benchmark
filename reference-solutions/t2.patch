@@ -0,0 +1,21 @@
+import {useEffect, useState} from 'react';
+import {Card, CardHeader, CardBody, Heading, Table, Thead, Tbody, Tr, Th, Td, Text} from '@chakra-ui/react';
+
+type Ride = {id: number, pickup: string, dropoff: string, requestTime: string, driverPlate: string, fare: number};
+export async function historyRequest(method: string, data?: object) {
+    const response = await fetch('/ride-history', {method, headers: {'Content-Type': 'application/json'}, body: data ? JSON.stringify(data) : undefined});
+    if (!response.ok) throw new Error(`Ride history: ${response.status}`);
+    return response.json();
+}
+export function RideHistory({revision}: {revision: number}) {
+    const [history, setHistory] = useState<{rides: Ride[], total: number}>({rides: [], total: 0});
+    const [error, setError] = useState(false);
+    useEffect(() => {
+        let active = true;
+        historyRequest('GET').then(data => {if (active) {setHistory(data); setError(false);}}).catch(() => {if (active) setError(true);});
+        return () => {active = false;};
+    }, [revision]);
+    return <Card maxW={600}><CardHeader><Heading size="md">Ride History</Heading><Text>Total rides: {history.total}</Text></CardHeader>
+        <CardBody>{error ? <Text>Could not load ride history</Text> : <Table><Thead><Tr><Th>Pickup</Th><Th>Dropoff</Th><Th>Time</Th><Th>Plate</Th><Th>Fare</Th></Tr></Thead>
+        <Tbody>{history.rides.map(ride => <Tr key={ride.id}><Td>{ride.pickup}</Td><Td>{ride.dropoff}</Td><Td>{new Date(ride.requestTime).toLocaleString()}</Td><Td>{ride.driverPlate || 'Pending'}</Td><Td>{ride.driverPlate ? `$${Number(ride.fare).toFixed(2)}` : 'Pending'}</Td></Tr>)}</Tbody></Table>}</CardBody></Card>;
+}
